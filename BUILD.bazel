load(
    "@//bazel:api.bzl",
    "mojo_library",
    "mojo_overlay_layer",
    "mojo_overlay_srcs",
    "mojo_test_environment",
)
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load(
    "//bazel:versions.bzl",
    "XMOJO_VERSION",
)
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

mojo_overlay_layer(
    name = "modular_stdlib_sources",
    srcs = ["@//mojo/stdlib/std:std_srcs"],
    strip_prefix = "mojo/stdlib/std/",
)

mojo_overlay_layer(
    name = "xmojo_stdlib_sources",
    srcs = glob(["mojo/stdlib/std/**/*.mojo"]),
    strip_prefix = "mojo/stdlib/std/",
)

mojo_overlay_srcs(
    name = "overlaid_stdlib_sources",
    layers = [
        ":modular_stdlib_sources",
        ":xmojo_stdlib_sources",
    ],
    stage_root = "std/",
)

mojo_library(
    name = "std",
    srcs = [":overlaid_stdlib_sources"],
    validate_missing_docs = False,
    deps = ["@//KGEN:CompilerRT"],
)

mojo_library(
    name = "max",
    srcs = ["@//max/mojo/max:max_srcs"],
    validate_missing_docs = False,
    deps = [
        ":std",
        "@modular_wheel//:AsyncRTMojoBindings_lib",
    ],
)

mojo_test_environment(
    name = "stdlib_environment",
    data = [
        ":std",
        "//mojo/xmojo:xmojo",
    ],
)

mojo_test_environment(
    name = "gpu_environment",
    data = [
        ":max",
        ":std",
        "//mojo/xmojo:xmojo",
    ],
)

cc_library(
    name = "spirv_target",
    srcs = ["src/compiler/XMojoSPIRVTarget.cpp"],
    alwayslink = True,
    deps = [
        "@//KGEN:KGENDialect",
        "@//KGEN:TargetBackend.headers",
        "@//KGEN:TargetLowering",
        "@//KGEN:TargetTraits",
        "@llvm-project//llvm:Core",
        "@llvm-project//llvm:Support",
        "@llvm-project//llvm:Target",
        "@llvm-project//mlir:IR",
    ],
)

cc_library(
    name = "interactive_session",
    srcs = glob([
        "src/compiler/*.cpp",
        "src/compiler/*.h",
    ]),
    hdrs = ["include/xmojo/InteractiveSession.h"],
    data = ["@//KGEN:CompilerRT"],
    strip_include_prefix = "include",
    deps = [
        ":spirv_target",
        "@//AsyncRT:CompilerSupport",
        "@//AsyncRT:Runtime",
        "@//Init",
        "@//KGEN:Compiler",
        "@//KGEN:ExecutionEngine",
        "@//KGEN:KGENDialect",
        "@//KGEN:LITDialect",
        "@//KGEN:MojoParser",
        "@//KGEN:MojoTooling",
        "@//KGEN:ObjectCompiler",
        "@//KGEN:ToolCommon",
        "@//KGEN:TransformUtils",
        "@//Support:Context",
        "@//Support:Filesystem",
        "@//Support:MDialect",
        "@llvm-project//llvm:OrcJIT",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:IR",
    ],
)

cc_test(
    name = "gpu_shared_library_test",
    srcs = ["tests/gpu_shared_library_test.cpp"],
    data = [
        ":gpu_environment",
        "@module_platlib_macos_arm64//:modular/lib/libAsyncRTMojoBindings.dylib",
    ],
    args = ["$(rootpath @module_platlib_macos_arm64//:modular/lib/libAsyncRTMojoBindings.dylib)"],
    env = {
        "MODULAR_CRASH_REPORTING_ENABLED": "0",
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_ONLY": "false",
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_SIZE": "0",
        "MODULAR_MOJO_MAX_IMPORT_PATH": "$(COMPUTED_IMPORT_PATH)",
    },
    target_compatible_with = ["@platforms//os:macos"],
    toolchains = [":gpu_environment"],
    deps = [
        ":interactive_session",
        "@llvm-project//third-party/unittest:gtest",
    ],
)

cc_library(
    name = "mojo_interpreter",
    srcs = ["src/kernel/MojoInterpreter.cpp"],
    hdrs = ["src/kernel/MojoInterpreter.h"],
    local_defines = ['XMOJO_VERSION=\\"%s\\"' % XMOJO_VERSION],
    deps = [
        ":interactive_session",
        "@xmojo_deps//:xeus",
    ],
)

cc_binary(
    name = "xmojo",
    srcs = [
        "src/CLI.h",
        "src/Kernel.cpp",
        "src/REPL.cpp",
        "src/SessionOptionsCLI.h",
        "src/xmojo.cpp",
    ],
    data = [
        ":kernelspec",
        ":stdlib_environment",
        "//mojo/compiler_std:std",
    ],
    env = {
        "MODULAR_CRASH_REPORTING_ENABLED": "0",
        "MODULAR_MOJO_MAX_COMPILERRT_PATH": "$(COMPILER_RT_PATH)",
        "MODULAR_MOJO_MAX_IMPORT_PATH": "$(COMPUTED_IMPORT_PATH)",
        "XMOJO_COMPILER_STDLIB_PATH": "$(rootpath //mojo/compiler_std:std)",
    },
    local_defines = ['XMOJO_VERSION=\\"%s\\"' % XMOJO_VERSION],
    toolchains = [":stdlib_environment"],
    deps = [
        ":interactive_session",
        ":mojo_interpreter",
        "@//KGEN/tools/mojo:mojo_common",
        "@xmojo_deps//:xeus_zmq",
    ],
)

filegroup(
    name = "kernelspec",
    srcs = ["share/jupyter/kernels/xmojo/kernel.json"],
)

copy_file(
    name = "wheel_xmojo_binary",
    src = ":xmojo.stripped",
    out = "python/xmojo/bin/xmojo",
    allow_symlink = True,
    is_executable = True,
)

copy_file(
    name = "wheel_compiler_rt_macos",
    src = "@//KGEN:CompilerRT",
    out = "python/xmojo/lib/libKGENCompilerRTShared.dylib",
    target_compatible_with = ["@platforms//os:macos"],
)

copy_file(
    name = "wheel_compiler_rt_linux",
    src = "@//KGEN:CompilerRT",
    out = "python/xmojo/lib/libKGENCompilerRTShared.so",
    target_compatible_with = ["@platforms//os:linux"],
)

copy_file(
    name = "wheel_support_globals_macos",
    src = "@//Support:Globals",
    out = "python/xmojo/lib/libMSupportGlobals.dylib",
    target_compatible_with = ["@platforms//os:macos"],
)

copy_file(
    name = "wheel_support_globals_linux",
    src = "@//Support:Globals",
    out = "python/xmojo/lib/libMSupportGlobals.so",
    target_compatible_with = ["@platforms//os:linux"],
)

copy_file(
    name = "wheel_async_rt_globals_macos",
    src = "@//AsyncRT:RuntimeGlobals",
    out = "python/xmojo/lib/libAsyncRTRuntimeGlobals.dylib",
    target_compatible_with = ["@platforms//os:macos"],
)

copy_file(
    name = "wheel_async_rt_globals_linux",
    src = "@//AsyncRT:RuntimeGlobals",
    out = "python/xmojo/lib/libAsyncRTRuntimeGlobals.so",
    target_compatible_with = ["@platforms//os:linux"],
)

copy_file(
    name = "wheel_compiler_std",
    src = "//mojo/compiler_std:std",
    out = "python/xmojo/mojo/compiler/std.mojoc",
)

copy_file(
    name = "wheel_std",
    src = ":std",
    out = "python/xmojo/mojo/std.mojoc",
)

copy_file(
    name = "wheel_xmojo_package",
    src = "//mojo/xmojo:xmojo_base",
    out = "python/xmojo/mojo/base/xmojo.mojoc",
)

copy_file(
    name = "wheel_xmojo_modular_gpu_package",
    src = "//mojo/xmojo:xmojo",
    out = "python/xmojo/mojo/modular_gpu/xmojo.mojoc",
)

filegroup(
    name = "wheel_assets",
    srcs = [
        ":wheel_compiler_std",
        ":wheel_std",
        ":wheel_xmojo_binary",
        ":wheel_xmojo_modular_gpu_package",
        ":wheel_xmojo_package",
    ] + select({
        "@platforms//os:macos": [
            ":wheel_async_rt_globals_macos",
            ":wheel_compiler_rt_macos",
            ":wheel_support_globals_macos",
        ],
        "@platforms//os:linux": [
            ":wheel_async_rt_globals_linux",
            ":wheel_compiler_rt_linux",
            ":wheel_support_globals_linux",
        ],
    }),
)

cc_test(
    name = "spirv_target_test",
    srcs = ["tests/spirv_target_test.cpp"],
    data = [":stdlib_environment"],
    env = {
        "MODULAR_CRASH_REPORTING_ENABLED": "0",
        "MODULAR_MOJO_MAX_IMPORT_PATH": "$(COMPUTED_IMPORT_PATH)",
    },
    toolchains = [":stdlib_environment"],
    deps = [
        ":interactive_session",
        "@llvm-project//third-party/unittest:gtest",
    ] + select({
        "@platforms//os:macos": ["@//bazel/internal:gtest_main_objc_pool_check"],
        "//conditions:default": ["@llvm-project//third-party/unittest:gtest_main"],
    }),
)

cc_test(
    name = "session_test",
    srcs = ["tests/session_test.cpp"],
    data = [":stdlib_environment"],
    env = {
        "MODULAR_CRASH_REPORTING_ENABLED": "0",
        "MODULAR_MOJO_MAX_IMPORT_PATH": "$(COMPUTED_IMPORT_PATH)",
    },
    toolchains = [":stdlib_environment"],
    deps = [
        ":interactive_session",
        "@llvm-project//third-party/unittest:gtest",
    ] + select({
        "@platforms//os:macos": ["@//bazel/internal:gtest_main_objc_pool_check"],
        "//conditions:default": ["@llvm-project//third-party/unittest:gtest_main"],
    }),
)

cc_test(
    name = "interpreter_test",
    srcs = ["tests/interpreter_test.cpp"],
    data = [":stdlib_environment"],
    env = {
        "MODULAR_CRASH_REPORTING_ENABLED": "0",
        "MODULAR_MOJO_MAX_IMPORT_PATH": "$(COMPUTED_IMPORT_PATH)",
    },
    toolchains = [":stdlib_environment"],
    deps = [
        ":mojo_interpreter",
        "@llvm-project//third-party/unittest:gtest",
    ] + select({
        "@platforms//os:macos": ["@//bazel/internal:gtest_main_objc_pool_check"],
        "//conditions:default": ["@llvm-project//third-party/unittest:gtest_main"],
    }),
)

sh_test(
    name = "cli_test",
    srcs = ["tests/cli_test.py"],
    args = [
        "$(rootpath :xmojo)",
        XMOJO_VERSION,
    ],
    data = [
        ":stdlib_environment",
        ":xmojo",
        "//mojo/compiler_std:std",
    ],
    env = {
        "MODULAR_CRASH_REPORTING_ENABLED": "0",
        "MODULAR_MOJO_MAX_COMPILERRT_PATH": "$(COMPILER_RT_PATH)",
        "MODULAR_MOJO_MAX_IMPORT_PATH": "$(COMPUTED_IMPORT_PATH)",
        "XMOJO_COMPILER_STDLIB_PATH": "$(rootpath //mojo/compiler_std:std)",
    },
    env_inherit = ["PATH"],
    toolchains = [":stdlib_environment"],
)

sh_test(
    name = "kernel_test",
    srcs = ["tests/kernel_test.py"],
    args = ["$(rootpath :xmojo)"],
    data = [
        ":stdlib_environment",
        ":xmojo",
    ],
    env = {
        "MODULAR_CRASH_REPORTING_ENABLED": "0",
        "MODULAR_MOJO_MAX_IMPORT_PATH": "$(COMPUTED_IMPORT_PATH)",
    },
    env_inherit = ["PATH"],
    toolchains = [":stdlib_environment"],
)
