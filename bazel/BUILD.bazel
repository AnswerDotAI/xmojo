load(
    ":official_mojo.bzl",
    "official_mojo_toolchain",
)
load(":versions.bzl", "MOJO_COMPILER_VERSION")

package(default_visibility = ["//visibility:public"])

toolchain_type(name = "official_mojo_toolchain_type")

official_mojo_toolchain(
    name = "official_mojo",
    compiler_path = ".pixi/envs/default/bin/mojo",
    compiler_version = MOJO_COMPILER_VERSION,
    modular_home = ".pixi/envs/default/share/max",
)

toolchain(
    name = "official_mojo_toolchain",
    toolchain = ":official_mojo",
    toolchain_type = ":official_mojo_toolchain_type",
)
