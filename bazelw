#!/usr/bin/env bash

set -euo pipefail

if [[ -n "${CODEX_SANDBOX:-}" ]]; then
  cat >&2 <<'EOF'
error: xmojo's Bazel wrapper must not run in a Codex sandbox.
Invoke ./bazelw directly under its Codex allow rule, outside the sandbox.
EOF
  exit 2
fi

script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
deps_root="${XMOJO_DEPS_ROOT:-$(dirname "$script_root")}"
modular_root="${XMOJO_MODULAR_ROOT:-$deps_root/modular}"
if [[ "$modular_root" != /* || ! -x "$modular_root/bazelw" || ! -f "$modular_root/bazel/mojo.MODULE.bazel" ]]; then
  echo "XMOJO_MODULAR_ROOT must be an absolute Modular checkout path" >&2
  exit 2
fi
export XMOJO_DEPS_ROOT="$deps_root"
export XMOJO_MODULAR_ROOT="$modular_root"
if [[ "$(uname -s)" == "Darwin" ]]; then
  default_output_user_root="$HOME/Library/Caches/bazel/xmojo-user-root-1"
else
  default_output_user_root="${XDG_CACHE_HOME:-$HOME/.cache}/bazel/xmojo-user-root-1"
fi
output_user_root="${XMOJO_BAZEL_OUTPUT_USER_ROOT:-$default_output_user_root}"
xeus_deps_root="$output_user_root/xmojo-xeus-deps"
startup_args=("--output_user_root=$output_user_root")
action_args=()
if [[ -n "${BBUDDY_API_KEY:-}" ]]; then
  action_args+=(
    "--bes_backend=grpcs://remote.buildbuddy.io"
    "--bes_results_url=https://app.buildbuddy.io/invocation/"
    "--remote_cache=grpcs://remote.buildbuddy.io"
    "--remote_header=x-buildbuddy-api-key=$BBUDDY_API_KEY"
    "--remote_instance_name=xmojo"
    "--remote_upload_local_results=true"
  )
elif [[ "${XMOJO_PUBLIC_CACHE:-0}" == "1" ]]; then
  action_args+=(
    "--config=public-cache"
    "--remote_header=x-buildbuddy-api-key=gJPttl2LQEONgD2aKziQ"
    "--remote_upload_local_results=false"
  )
fi
if [[ "$(uname -s)" == "Darwin" ]]; then
  developer_dir="$(xcode-select -p)"
  xcode_build_number="$(/usr/bin/xcodebuild -version | awk '/Build version/ {print $3}')"
  action_args+=(
    "--action_env=DEVELOPER_DIR=$developer_dir"
    "--host_action_env=DEVELOPER_DIR=$developer_dir"
    "--repo_env=DEVELOPER_DIR=$developer_dir"
    "--repo_env=XCODE_VERSION=$xcode_build_number"
  )
fi

for arg in "$@"; do
  if [[ "$arg" == "--" ]]; then break; fi
  case "$arg" in
  --action_env | --action_env=* | \
    --host_action_env | --host_action_env=* | \
    --inject_repository | --inject_repository=* | \
    --extra_toolchains | --extra_toolchains=* | \
    --check_visibility | --check_visibility=* | --nocheck_visibility | \
    --output_user_root | --output_user_root=* | \
    --config | --config=build-mojo)
    echo "bazelw owns $arg; configure it in the wrapper rather than per invocation" >&2
    exit 2
    ;;
  esac
done

cd "$modular_root"

if [[ $# -eq 0 ]]; then
  exec "$modular_root/bazelw" "${startup_args[@]}"
fi

command="$1"
shift

case "$command" in
aquery | build | cquery | run | test)
  uses_xmojo=0
  needs_xeus=0
  for target in "$@"; do
    case "$target" in
    *@xmojo//:gpu_launcher* | *@xmojo//:gpu_shared_library_test*)
      uses_xmojo=1
      pixi install --manifest-path "$script_root/pixi.toml"
      if [[ "$command" == test ]]; then
        action_args+=(
          "--test_env=XMOJO_MOJO_COMPILER=$script_root/.pixi/envs/default/bin/mojo"
          "--test_env=XMOJO_MODULAR_HOME=$script_root/.pixi/envs/default/share/max"
        )
      fi
      ;;
    *@xmojo//*)
      uses_xmojo=1
      needs_xeus=1
      ;;
    esac
  done
  repository_args=("--inject_repository=xmojo=$script_root")
  if (( uses_xmojo )); then
    if ! grep -Fqx 'llvm_configure.configure(extra_targets = ["SPIRV"])' \
      "$modular_root/MODULE.bazel"; then
      echo 'modular/MODULE.bazel must enable llvm_configure extra target "SPIRV"; see xmojo/DEV.md' >&2
      exit 2
    fi
    if (( needs_xeus )); then
      "$script_root/tools/build_xeus_deps.sh" "$xeus_deps_root" "$output_user_root"
    else
      "$script_root/tools/build_xeus_deps.sh" "$xeus_deps_root" "$output_user_root" prepare
    fi
    repository_args+=("--inject_repository=xmojo_deps=$xeus_deps_root/install")
  fi
  exec "$modular_root/bazelw" "${startup_args[@]}" "$command" --config=build-mojo \
    "${action_args[@]}" \
    --check_visibility=false \
    --extra_toolchains=@xmojo//bazel:official_mojo_toolchain \
    "${repository_args[@]}" "$@"
  ;;
*)
  exec "$modular_root/bazelw" "${startup_args[@]}" "$command" "$@"
  ;;
esac
